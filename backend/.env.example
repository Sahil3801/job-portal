# Set these as environment variables (Render dashboard -> Environment, or your IDE run config)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/jobPortal?retryWrites=true&w=majority
JWT_SECRET=<output of: openssl rand -base64 64>

# Password reset emails. Pick ONE way to send them:
# Option A - Brevo HTTPS API (works on Render's free tier, which may block SMTP):
BREVO_API_KEY=<your Brevo API key>
MAIL_FROM=<a sender email you verified in Brevo>
# Option B - Gmail SMTP:
MAIL_USERNAME=<your gmail address>
MAIL_PASSWORD=<gmail app password>
